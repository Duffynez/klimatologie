# Preserve the published SHA-256 checksums of the NOAA data extracts.
public/data/methods/resistance-thermometry/*.txt text eol=lf
public/data/methods/hygrometry/*.txt text eol=lf
# Keep the CHMI archive member byte-for-byte, including its original line endings.
public/data/methods/radiosounding/*.csv binary
# Keep the checksum of our pressure-calibration transcription stable across checkouts.
public/data/methods/pressure-height/*.csv text eol=lf
public/data/methods/conductometry/*.csv text eol=lf
public/data/methods/rain-gauges/*.txt text eol=lf
# Preserve the original NOAA API responses and their published checksums.
public/data/methods/tide-gauges/water-level-*.json binary
public/data/methods/tide-gauges/datums.json binary
# Preserve the upstream README bytes and reproducible photogrammetry table hashes.
public/data/methods/photogrammetry/source-README.md binary
public/data/methods/photogrammetry/*.csv text eol=lf
public/data/methods/photogrammetry/*.geojson text eol=lf

public/data/methods/radiative-fluxes/*.dat binary
public/data/methods/radiative-fluxes/source-README.txt binary
public/data/methods/radiative-fluxes/*.csv text eol=lf
public/data/methods/infrared-radiometry/*.csv text eol=lf
public/data/methods/microwave-radiometry/*.csv text eol=lf
# Keep the radar example files byte-for-byte to preserve their published hashes.
public/data/radar/* text eol=lf
# Keep the lidar example checksums stable on Windows and in the Pages build.
public/data/methods/lidar/* text eol=lf

public/data/methods/altimetry/* text eol=lf
public/data/methods/interferometry/* text eol=lf
public/data/methods/gravimetry/* text eol=lf
public/data/methods/occultation/* text eol=lf
public/data/methods/gnss-water/* text eol=lf

public/data/methods/ice-cores/* text eol=lf
public/data/methods/ice-cores/*.xlsx binary

public/data/methods/sediment-cores/* text eol=lf

public/data/methods/dendrochronology/* text eol=lf
public/data/methods/dendrochronology/yad.raw binary

public/data/methods/coral-sclerochronology/* text eol=lf
public/data/methods/coral-sclerochronology/*-original.txt binary

public/data/methods/speleothems/* text eol=lf
public/data/methods/speleothems/*-original.txt binary

# Preserve the PANGAEA pollen export and its checksum on every platform.
public/data/methods/pollen/pg1351-original.tsv binary

